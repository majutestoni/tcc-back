# API do Gemini — obtenha a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo (opcional). Ex.: gemini-3.6-flash, gemini-3.6-pro
GEMINI_MODEL=gemini-3.6-flash

# Temperatura (opcional, 0.0-1.0). Menor = mais determinístico
GEMINI_TEMPERATURE=0.3

# Limite de tokens de saída (opcional)
# GEMINI_MAX_OUTPUT_TOKENS=1024
